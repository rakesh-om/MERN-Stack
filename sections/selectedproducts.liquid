
<div id="selected-products">
    <div class="container">
        <div class="content">
            <h2>Loading...</h2>
            
        </div>
    </div>
</div>

<script>
   
    document.addEventListener("DOMContentLoaded", function () {

    updateCartCount(); 

    let storedData = localStorage.getItem("buyingGuideData");
    let outputContainer = document.getElementById("selected-products").querySelector(".content");

    if (storedData) {
        let data = JSON.parse(storedData);
        if (!data.categoryData || !Array.isArray(data.categoryData)) {
            outputContainer.innerHTML = "<p>Error: No category data found.</p>";
            return;
        }

        let content = `<h2>Selected Products for ${data.country}, ${data.state}</h2>`;
        content += `<p><strong>Total Budget:</strong> 
        Rs.${data.budget}</p>`;

        let categorySpentAmounts = {}; 

        data.categoryData.forEach(item => {
            if (!item.filteredProducts || item.filteredProducts.length === 0) {
                content += `<p>Error: No products found for ${item.category}.</p>`;
                return;
            }   

            let allocatedAmount = parseFloat(item.allocatedAmount);
            categorySpentAmounts[item.category] = 0; 

            content += `<h3>${item.category} (${item.percentage}%)</h3>`;
            content += `<p>Allocated Budget: Rs.${allocatedAmount}</p>`;
            content += `<div class="products-container">`;

            item.filteredProducts.forEach(product => {
                if (!product.images || product.images.length === 0) return;

                let productImage = product.images[0].src;
                let productUrl = `/products/${product.handle}`;
                let variantId = product.variants[0].id;
                let productPrice = parseFloat(product.variants[0].price);

                
                if (productPrice <= allocatedAmount) {
                    content += `
                        <div class="product-card">
                            <a href="${productUrl}">
                                <img src="${productImage}" alt="${product.title}" class="product-image">
                            </a>
                            <p><a href="${productUrl}">${product.handle}</a></p>
                            <p><strong>Price:</strong> Rs. ${productPrice}</p>
                            <button class="add-to-cart" data-variant-id="${variantId}" data-price="${productPrice}" data-category="${item.category}">Add to Cart</button>
                        </div>
                    `;
                }
            });

            content += `</div>`;
        });

        outputContainer.innerHTML = content;

        document.querySelectorAll(".add-to-cart").forEach(button => {
            button.addEventListener("click", function () {
                let variantId = this.getAttribute("data-variant-id");
                let productPrice = parseFloat(this.getAttribute("data-price"));
                let category = this.getAttribute("data-category");

                if (categorySpentAmounts[category] + productPrice > data.categoryData.find(c => c.category === category).allocatedAmount) {
                    alert(`You have exceeded the allocated budget for ${category}. Please select a cheaper product.`);
                } else {
                    categorySpentAmounts[category] += productPrice; 
                    addToCart(variantId);
                }
            });
        });
    } else {
        outputContainer.innerHTML = "<p>No data found.</p>";
    }
});

function addToCart(variantId) {
    fetch("/cart/add.js", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ id: variantId, quantity: 1 })
    })
    .then(response => response.json())
    .then(() => {
        updateCartCount(); 
        alert("Product added to cart!");
    })
    .catch(error => {
        console.error("Error adding to cart:", error);
        alert("Failed to add product to cart.");
    });
}

function updateCartCount() {
    fetch("/cart.js")
    .then(response => response.json())
    .then(cart => {
        let cartBubble = document.querySelector(".cart-count-bubble span[aria-hidden='true']");

        if (cartBubble) {
            cartBubble.textContent = cart.item_count > 0 ? cart.item_count : "";
        }
    })
    .catch(error => console.error("Error updating cart count:", error));
}
</script>


<style>
#selected-products {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    padding: 20px;
    background-color: #f4f4f9;
}

.container {
    width: 100%;
    max-width: 1200px;
    padding: 20px;
    margin: 0 auto;
    text-align: center;
}

h2 {
    font-size: 2.2rem;
    color: #222;
    text-align: center;
    font-weight: bold;
}

h3 {
    font-size: 1.8rem;
    color: #333;
    margin-top: 20px;
    font-style: italic;
    text-transform: capitalize;
}

p {
    font-size: 1.2rem;
    color: #555;
}

strong {
    font-weight: bold;
    color: #222;
}

/* Product Container */
.products-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    gap: 25px;
    justify-content: center;
    padding-top: 20px;
}

/* Product Card */
.product-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    width: 270px;
    border: none;
    border-radius: 12px;
    padding: 15px;
    text-align: center;
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
    background: linear-gradient(to bottom, #ffffff, #f8f9fa);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    height: 100%;
}

.product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
}

/* Product Image */
.product-image {
    width: 100%;
    height: 220px;
    object-fit: cover;
    border-radius: 10px;
}

/* Product Info */
.product-card p a {
    text-decoration: none;
    color: #0073e6;
    font-size: 1rem;
    font-weight: 500;
    margin-top: 10px;
    display: block;
    transition: color 0.3s ease;
}

.product-card p a:hover {
    color: #004a99;
}

/* Add to Cart Button */
button.add-to-cart {
    background: linear-gradient(135deg, #080808, #333);
    color: #fff;
    padding: 12px 22px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    margin-top: 12px;
    width: 100%;
    font-size: 1.1rem;
    font-weight: bold;
    transition: background 0.3s ease, transform 0.2s ease;
}

button.add-to-cart:active {
    transform: scale(0.98);
}


</style>


