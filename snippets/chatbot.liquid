{{ 'chatbot.css' | asset_url | stylesheet_tag }}
{{ 'chatbot.js' | asset_url | script_tag }}

{% if template != 'cart' and template != 'checkout' %}
<div class="chatbot-container"> 
    <div class="chatbot-toggle">
        <img class="chatbot-icon" src="{{ 'chatbot.svg' | asset_url }}" alt="Chatbot" height="50" width="50">
    </div>

    <div class="ai-buying-guide">
    <span class="close-chatbot">&times;</span>

    <form id="buying-guide-form">
            <select name="country" id="country-select" class="select-country">
                {% for country in country_option_tags %}
                  {{ country }}
                {% endfor %}
            </select>

            <select name="province" id="province-select" class="select-state">
                <option value="" disabled selected>Select State</option>
                {% assign states = "Haryana,Maharashtra,UP,Delhi,Jammu" | split: "," %}
                {% for state in states %}
                    <option value="{{ state }}">{{ state }}</option>
                {% endfor %}
            </select>

            <select id="category-select" name="category" class="category-dropdown">
                <option value="" disabled selected>Select Category</option>
                {% for collection in collections %}
                    <option value="{{ collection.handle }}">{{ collection.title }}</option>
                {% endfor %}
            </select>

            <div class="selected-categories"></div>
            <input type="number" id="total-budget" name="total_budget" placeholder="Enter Budget" min="1">
            <div class="category-percentages"></div>
            <div class="calculated-amounts"></div>
       
    </form>

    <button class="submit-btn">Submit</button>
</div>

</div>
{% endif %}
